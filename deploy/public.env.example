# Find this on the target host with: stat -c %g /var/run/docker.sock
DOCKER_GID=REPLACE_WITH_HOST_DOCKER_SOCKET_GROUP_ID

# Set after the server receives its public IPv4 address.
# sslip.io resolves this example-style hostname to the embedded IP address.
CPG_PUBLIC_HOSTNAME=REPLACE_WITH_APP_NAME_AND_PUBLIC_IP.sslip.io
