FROM docker:29.6.2-cli AS docker-cli

FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    PORT=8080 \
    CPG_PUBLIC_HOST=0.0.0.0 \
    CPG_COMPILER_VERSION=0.31.1 \
    CPG_COMPILER_IMAGE=cpg-compact-compiler:0.31.1

WORKDIR /app
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --chown=node:node core.mjs public-inspect.mjs public-server.mjs ./
COPY --chown=node:node public/ ./public/

USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8080/api/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "public-server.mjs"]
