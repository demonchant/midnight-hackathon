{
  "name": "compact-privacy-change-gate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "start:public": "node public-server.mjs",
    "start:public:stack": "docker compose -f compose.public.yaml up -d --build",
    "stop:public:stack": "docker compose -f compose.public.yaml down",
    "start:wsl": "bash run-wsl.sh",
    "test": "node verify.mjs",
    "test:compiler": "node scripts/check-compiler.mjs",
    "test:public-api": "node public-api-test.mjs",
    "build:compiler": "docker build -f deploy/Dockerfile.compiler -t cpg-compact-compiler:0.31.1 .",
    "build:public:images": "npm run build:compiler && docker compose -f compose.public.yaml build",
    "verify:compiler": "docker run --rm --network=none --memory=768m --memory-swap=768m --cpus=1 --pids-limit=64 --read-only --security-opt=no-new-privileges --cap-drop=ALL --user=65534:65534 --tmpfs=/work:rw,nosuid,nodev,size=256m,uid=65534,gid=65534,mode=1777 --tmpfs=/tmp:rw,noexec,nosuid,nodev,size=128m,uid=65534,gid=65534,mode=1777 --env=HOME=/root --env=TMPDIR=/tmp --env=COMPACT_DIRECTORY=/opt/compact-home/.compact --workdir=/work --entrypoint=/bin/sh cpg-compact-compiler:0.31.1 -ec 'command -v compact; compact --version; compact compile --version; find \"$COMPACT_DIRECTORY/versions/0.31.1\" -type f -name compactc -print -quit | grep .'",
    "test:public-compiler": "node public-smoke.mjs",
    "verify:hosted": "node verify-hosted.mjs",
    "inspect": "node cli.mjs",
    "contract:compile": "node scripts/compile-private-contract.mjs",
    "contract:demo": "npm run contract:compile && node examples/private-state-path.mjs",
    "contract:gate": "node scripts/check-private-contract-policy.mjs",
    "devnet:up": "node scripts/docker-local.mjs up",
    "devnet:down": "node scripts/docker-local.mjs down",
    "contract:local-e2e": "npm run contract:compile && node scripts/deploy-private-counter-local.mjs",
    "e2e": "playwright test --config playwright.config.mjs",
    "e2e:public": "playwright test --config playwright.public.config.mjs"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnightntwrk/wallet-sdk": "1.2.0",
    "@playwright/test": "1.64.0",
    "rxjs": "7.8.2",
    "ws": "8.21.3"
  },
  "engines": { "node": ">=22" }
}
